{
  "schema": 1,
  "name": "Tidewatch Console",
  "platforms": ["web"],
  "tokens": {
    "shared": ["tokens/palette.json", "tokens/shape.json"],
    "modes": {
      "light": ["tokens/modes/light.json"],
      "dark": ["tokens/modes/dark.json"],
      "contrast": ["tokens/modes/contrast.json"]
    }
  },
  "defaultMode": "light",
  "slots": {
    "surface.base": "ui.bg.page",
    "surface.elevated": "ui.bg.card",
    "surface.subtle": "ui.bg.well",
    "surface.interactive": "ui.bg.press",
    "text.primary": "ui.ink.main",
    "text.secondary": "ui.ink.quiet",
    "text.muted": "ui.ink.faint",
    "text.disabled": "ui.ink.off",
    "text.inverted": "ui.ink.reverse",
    "border.faint": "ui.edge.thin",
    "border.default": "ui.edge.thick",
    "brand.primary": "ui.action.main",
    "brand.primary-foreground": "ui.action.on-main",
    "brand.primary-hover": "ui.action.main-hover",
    "brand.accent": "ui.action.alt",
    "brand.accent-foreground": "ui.action.on-alt",
    "status.critical.bg": "ui.alert.danger.fill",
    "status.critical.text": "ui.alert.danger.ink",
    "status.warning.bg": "ui.alert.warn.fill",
    "status.warning.text": "ui.alert.warn.ink",
    "status.caution.bg": "ui.alert.notice.fill",
    "status.caution.text": "ui.alert.notice.ink",
    "status.info.bg": "ui.alert.note.fill",
    "status.info.text": "ui.alert.note.ink",
    "status.success.bg": "ui.alert.ok.fill",
    "status.success.text": "ui.alert.ok.ink",
    "chart.1": "ui.plot.tide",
    "chart.2": "ui.plot.swell",
    "chart.3": "ui.plot.wind",
    "chart.4": "ui.plot.draft",
    "chart.other": "ui.plot.rest",
    "radius.sm": "shape.round.tight",
    "radius.md": "shape.round.mid",
    "radius.lg": "shape.round.loose",
    "font.sans": "face.body",
    "font.mono": "face.code",
    "type.metric": "face.reading"
  },
  "components": "components.json",
  "voice": "voice.md"
}
