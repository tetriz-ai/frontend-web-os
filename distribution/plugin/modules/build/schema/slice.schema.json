{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fwos:schema:slice",
  "title": ".fwos/slices/<change>/<slice>.json",
  "description": "What one slice built, committed with it: the modules it may touch, the screens, components, states and ACs it covers.",
  "type": "object",
  "required": ["schema", "slice", "change", "title", "platform", "modules", "acs"],
  "properties": {
    "schema": { "const": 1 },
    "slice": { "type": "string", "pattern": "^S[0-9]+[a-z]?$" },
    "change": { "type": "string" },
    "title": { "type": "string" },
    "platform": { "enum": ["web", "electron", "mac"] },
    "modules": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "screens": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "components": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "states": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$" }, "uniqueItems": true },
    "acs": { "type": "array", "items": { "type": "string", "pattern": "^AC-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]+$" }, "uniqueItems": true },
    "dependsOn": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["planned", "in-progress", "done"] }
  },
  "additionalProperties": false
}
